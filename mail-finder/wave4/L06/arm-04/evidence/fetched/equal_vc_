let buttonBottomMobile = document.querySelector('#btn-bottom-mobile')

function moveUp() {
  if (latestPosts[1].classList.contains('active')) {
    latestPosts[1].classList.remove("active");
    latestPosts[0].classList.add("active");
  } else if (latestPosts[2].classList.contains('active')) {
    latestPosts[2].classList.remove("active");
    latestPosts[1].classList.add("active");
  } else {
    latestPosts[0].classList.remove("active");
    latestPosts[2].classList.add("active");
  }
}

function moveBottom() {
  if (latestPosts[1].classList.contains('active')) {
    latestPosts[1].classList.remove("active");
    latestPosts[2].classList.add("active");
  } else if (latestPosts[0].classList.contains('active')) {
    latestPosts[0].classList.remove("active");
    latestPosts[1].classList.add("active");
  } else {
    latestPosts[2].classList.remove("active");
    latestPosts[0].classList.add("active");
  }
}

