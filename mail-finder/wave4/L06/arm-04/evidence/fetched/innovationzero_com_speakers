										firstMoreMenuItem.find('.p-menu__item__submenu__item__submenu-toggle__icon').attr('class', this.config.classes.mainMenuItemSubMenuToggleIcon);									
										firstMoreMenuItem.insertBefore(menu.find('.p-menu__item--more'));
										
										this.fitMenu();
