<script>
document.addEventListener('DOMContentLoaded', () => {
    
    // --- GROUP A: The Toggles (Open/Close) ---
    // Clicking '.burger-icon' switches the state.
    const burgerIcons = document.querySelectorAll('.burger-icon');
    
    burgerIcons.forEach(icon => {
        icon.addEventListener('click', () => {
            document.body.classList.toggle('no-scroll');
        });
    });


    // --- GROUP B: The Closers (Force Close) ---
    // Clicking either '.close-btn' OR '.overlay-ham' will strictly UNFREEZE the body.
    // We use a comma to select both classes at once.
    const closeElements = document.querySelectorAll('.hamburger-close-wrapper, .overlay-ham');

    closeElements.forEach(element => {
        element.addEventListener('click', () => {
            // We use 'remove' instead of 'toggle' here to be safe.
            // This ensures that clicking a close button NEVER accidentally locks the scroll.
            document.body.classList.remove('no-scroll');
        });
    });

});
</script><script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Target the child element inside your wrapper
    const navWhite = document.getElementById('nav-white');

    // Safety check
    if (!navWhite) {
        return; // Exits if ID isn't found
    }

    // 2. Setup Variables
    let lastScrollY = window.scrollY;
    
    // Add transition directly via JS so you don't forget it in CSS
    navWhite.style.transition = 'transform 0.3s ease-in-out';

    // 3. The Scroll Handler
    window.onscroll = () => {
        const currentScrollY = window.scrollY;
        const scrollingDown = currentScrollY > lastScrollY;
        const scrollThreshold = 100; // Won't hide until you scroll down 100px

        // Logic: Are we past the top threshold?
        if (currentScrollY > scrollThreshold) {
            
            if (scrollingDown) {
                // SCROLLING DOWN -> Move the child nav UP out of view
                navWhite.style.transform = 'translateY(-150px)';
            } else {
                // SCROLLING UP -> Bring the child nav back DOWN
                navWhite.style.transform = 'translateY(0%)';
            }
            
        } else {
            // We are at the very top of the page -> Always show nav
            navWhite.style.transform = 'translateY(0%)';
        }

        lastScrollY = currentScrollY;
    };
});
</script>

