<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1. Define your non-default languages (subdirectories)
  const langCodes = ['fr', 'de', 'es', 'pt', 'nl'];

  // 2. Select all buttons with the 'data-lang' attribute
  const langButtons = document.querySelectorAll('[data-lang]');

  langButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault(); // Stop standard link behavior
      
      const targetLang = this.getAttribute('data-lang');
      let currentPath = window.location.pathname;
      let newPath = currentPath;

      // 3. Strip existing language code to get the "Clean Path"
      // Checks if URL starts with /fr/, /de/, etc.
      for (const code of langCodes) {
        if (currentPath.startsWith('/' + code + '/')) {
          newPath = currentPath.replace('/' + code, '');
          break;
        } else if (currentPath === '/' + code) {
          newPath = '/';
          break;
        }
      }

      // 4. Build the new URL
      if (targetLang === 'en') {
        // If English, just use the clean path (e.g., "/about")
        // Ensure we don't end up with empty string
        window.location.href = newPath || '/';
      } else {
        // For others, prepend the language (e.g., "/fr/about")
        // Ensure we don't double slash (//)
        if (newPath === '/') {
            window.location.href = '/' + targetLang;
        } else {
            window.location.href = '/' + targetLang + newPath;
        }
      }
    });
  });
});
</script>


