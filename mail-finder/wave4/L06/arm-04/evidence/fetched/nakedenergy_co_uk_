<script>
// Accordion config
const accSettings = {
  speed: 300,
  oneOpen: true,
  classes: {
    accordion: 'js-accordion',
    header: 'js-accordion-header',
    item: 'js-accordion-item',
    body: 'js-accordion-body',
    icon: 'js-accordion-icon',
    active: 'faq-active', // ✅ correct active class
  }
};

const prefix = accSettings.classes;

const simpleAccordion = (function() {
  const accordionElem = $(`.${prefix.accordion}`);
  const accordionHeader = accordionElem.find(`.${prefix.header}`);
  const activeClass = prefix.active;

  return {
    init: function(settings) {
      $.extend(accSettings, settings);

      accordionHeader.on('click', function() {
        simpleAccordion.toggle($(this));
      });

      // ✅ Open first item by default
      const $firstItem = accordionElem.find(`.${prefix.item}`).first();
      $firstItem.addClass(activeClass);
      $firstItem.find(`> .${prefix.body}`).show();
      $firstItem.find(`> .${prefix.header} > .${prefix.icon}`).addClass(activeClass);

      // Enforce oneOpen on init
      if (accSettings.oneOpen) {
        const activeItems = $(`.${prefix.item}.${activeClass}`);
        if (activeItems.length > 1) {
          activeItems.not(':first')
            .removeClass(activeClass)
            .find(`.${prefix.body}`).hide()
            .end().find(`.${prefix.header} > .${prefix.icon}`).removeClass(activeClass);
        }
      }

      // Show content and icon for any pre-opened items
      $(`.${prefix.item}.${activeClass}`).each(function() {
        $(this).find(`> .${prefix.body}`).show();
        $(this).find(`> .${prefix.header} > .${prefix.icon}`).addClass(activeClass);
      });
    },

    toggle: function($header) {
      const $item = $header.closest(`.${prefix.item}`);
      const $accordion = $header.closest(`.${prefix.accordion}`);
      const $icon = $header.find(`.${prefix.icon}`);

      if (accSettings.oneOpen && !$item.hasClass(activeClass)) {
        $accordion.find(`.${prefix.item}`).each(function() {
          const $i = $(this);
          $i.removeClass(activeClass);
          $i.find(`> .${prefix.body}`).slideUp(accSettings.speed);
          $i.find(`> .${prefix.header} > .${prefix.icon}`).removeClass(activeClass);
        });
      }

      $item.toggleClass(activeClass);
      $item.find(`> .${prefix.body}`).stop().slideToggle(accSettings.speed);
      $icon.toggleClass(activeClass);
    }
  };
})();

$(document).ready(function() {
  simpleAccordion.init(accSettings);
});
</script>


