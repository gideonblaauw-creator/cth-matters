<script>
    const frmSearchList = document.querySelectorAll('.frm-searchCustom');
    const MAX_QUERY_LENGTH = 1200;

    function openNeoFeedAI(searchTerm) {

        const url = new URL("https://neofeed.ai/");
        url.searchParams.set("q", searchTerm);
        window.open(url.toString(), '_blank');
    }

    frmSearchList.forEach(function(frmSearch) {
        frmSearch.addEventListener('submit', function(event) {
            const inputSearch = frmSearch.querySelector('.inputSearch');
            if (!inputSearch) return;

            const searchTerm = inputSearch.value.trim();

            if (searchTerm === '') {
                return;
            }

            event.preventDefault();

            const safeSearchTerm = searchTerm.length > MAX_QUERY_LENGTH
                ? searchTerm.slice(0, MAX_QUERY_LENGTH)
                : searchTerm;

            openNeoFeedAI(safeSearchTerm);
            inputSearch.value = '';
        });
    });
</script>

