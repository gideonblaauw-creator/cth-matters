sample" data-name="sample" placeholder="" type="text" id="sample" data-honeypot="true"/><div class="spacer-small"></div><input type="submit" data-wait="Please wait..." class="form-button-submit w-button" value="Submit"/></form><div class="contact-success-message w-form-done"><div>Thank you! Your submission has been received!</div></div><div class="contact-error-message w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div></div></div></div></div><div class="form-embed w-embed w-script"><script>
(function () {
  // --- config ---
  const MIN_FILL_MS = 3000; // time-trap: minimum ms between form render and submit

  // --- helpers/regex ---
  const GUID_RE  = /^[0-9a-f-]{36}$/i;
  const PORTAL_RE = /^\d{5,9}$/;
  const HUTK_RE   = /^[0-9a-f]{40}$/i;

  // Honeypot selectors we skip/block
  const HP_SELECTORS = [
    '[data-honeypot="true"]',
    'input[name="sample"]',           // safe if you keep the name "sample"
    'input[name="honey-pot-field"]',
    'input[name="website"]',
    'input[name="hp_field"]'
  ];

  function getCookie(name){
    const m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return m ? decodeURIComponent(m[2]) : null;
  }

  function discoverPortalId(form){
    // 1) Per-form attribute
    const fromAttr = (form.getAttribute('data-hs-portal') || '').trim();
    if (PORTAL_RE.test(fromAttr)) return fromAttr;

    // 2) <meta name="hubspot-portal-id" content="...">
    const meta = document.querySelector('meta[name="hubspot-portal-id"]');
    if (meta && PORTAL_RE.test(meta.content)) return meta.content.trim();

    // 3) HubSpot globals (if tracking code/chat is installed)
    if (window.hsVars && PORTAL_RE.test(String(window.hsVars.portalId)))
      return String(window.hsVars.portalId);

    // 4) _hsq queue (looks like ["setPortalId", "46354330"])
    if (Array.isArray(window._hsq)) {
      for (const item of window._hsq) {
        if (Array.isArray(item) && item[0] === 'setPortalId' && PORTAL_RE.test(String(item[1])))
          return String(item[1]);
      }
    }
    return null; // not found
  }

  function getHoneypot(form){
    for (const sel of HP_SELECTORS) {
      const el = form.querySelector(sel);
      if (el) return el;
    }
    return null;
  }

  function collectFields(form){
    const fields = [];
    form.querySelectorAll('input, select, textarea').forEach(el => {
      if (!el.name || el.disabled) return;
      if (el.type === 'submit' || el.type === 'button') return;

      // Skip honeypot(s)
      if (el.matches(HP_SELECTORS.join(','))) return;

      if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) return;

      if (el.tagName === 'SELECT' && el.multiple) {
        Array.from(el.selectedOptions).forEach(o => fields.push({ name: el.name, value: o.value }));
      } else {
        fields.push({ name: el.name, value: el.value });
      }
    });
    return fields;
  }

  function uiFor(form){
    const wrap = form.closest('.w-form') || form.parentElement;
    return {
      wrap,
      success: wrap && wrap.querySelector('.w-form-done'),
      fail: wrap && wrap.querySelector('.w-form-fail')
    };
  }

  function resetUI(form){
    const { success, fail } = uiFor(form);
    if (success) success.style.display = 'none';
    if (fail)    fail.style.display = 'none';
    form.style.display = ''; // ensure form is visible for a new attempt
  }

  function showResult(form, ok, message){
    const { success, fail } = uiFor(form);
    if (ok) {
      if (fail) fail.style.display = 'none';
      if (success) success.style.display = 'block';
      form.style.display = 'none';
    } else {
      if (success) success.style.display = 'none'; // never show success on error/spam
      if (fail) {
        fail.style.display = 'block';
        fail.textContent = message || 'Submission error.';
      }
      form.style.display = ''; // keep form visible
    }
  }

  // --- bind all forms that declare a HubSpot formId ---
  document.querySelectorAll('form[data-hs-form]').forEach(form => {
    if (form.__hsBound) return; // prevent double-bind
    form.__hsBound = true;

    // Disable native validation to avoid "not focusable" when hidden inputs exist
    form.setAttribute('novalidate', '');

    // mark render time for time-trap
    form.__loadedAt = Date.now();

    // clear any leftover UI on load
    resetUI(form);

    const formId = (form.getAttribute('data-hs-form') || '').trim();
    const redirect = (form.getAttribute('data-hs-redirect') || '').trim();
    const wantsConsent = (form.getAttribute('data-hs-consent') || '').toLowerCase() === 'true';
    const debug = (form.getAttribute('data-hs-debug') || '').toLowerCase() === 'true';

    if (!GUID_RE.test(formId)) {
      showResult(form, false, 'Invalid HubSpot formId on form.');
      if (debug) console.error('Invalid formId:', formId, form);
      return;
    }

    const portalId = discoverPortalId(form);
    if (!portalId) {
      showResult(form, false, 'No HubSpot portalId found. Add data-hs-portal or a meta hubspot-portal-id.');
      if (debug) console.error('Portal ID not found for form:', form);
      return;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // fresh UI state for this attempt
      resetUI(form);

      // Strip required from any hidden or honeypot fields to avoid native blocking
      form.querySelectorAll('[required]').forEach(el => {
        const isHp = el.matches(HP_SELECTORS.join(','));
        const cs = window.getComputedStyle(el);
        const isHidden = el.type === 'hidden' ||
                         cs.display === 'none' ||
                         cs.visibility === 'hidden' ||
                         el.offsetParent === null;
        if (isHp || isHidden) el.required = false;
      });

      // --- spam checks: honeypot + time-trap ---
      const hp = getHoneypot(form);
      if (hp && String(hp.value || '').trim().length > 0) {
        showResult(form, false, 'Spam detected.');
        if (debug) console.warn('[HS] honeypot triggered on form:', form);
        return; // do NOT call HubSpot
      }
      const elapsed = Date.now() - (form.__loadedAt || Date.now());
      if (elapsed < MIN_FILL_MS) {
        showResult(form, false, 'Please wait a moment and try again.');
        if (debug) console.warn('[HS] time-trap triggered; elapsed(ms)=', elapsed);
        return; // do NOT call HubSpot
      }

      const btn = form.querySelector('input[type="submit"], button[type="submit"]');
      if (btn) btn.disabled = true;

      const fields = collectFields(form);

      // Page context; add hutk only when valid to avoid INVALID_HUTK
      const context = { pageUri: location.href, pageName: document.title };
      const hutk = getCookie('hubspotutk');
      if (hutk && HUTK_RE.test(hutk)) context.hutk = hutk;

      const payload = { fields, context };
      if (wantsConsent) {
        payload.legalConsentOptions = { consent: { consentToProcess: true, communications: [] } };
      }

      const endpoint = `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formId}`;
      if (debug) console.log('[HS] submit →', endpoint, payload);

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const text = await res.text();

        if (res.ok) {
          if (redirect) window.location.href = redirect;
          else showResult(form, true);
        } else {
          // Friendly hint if CAPTCHA accidentally left on
          if (text && text.includes('FORM_HAS_RECAPTCHA_ENABLED')) {
            showResult(form, false, 'This HubSpot form has CAPTCHA enabled, so API submissions are blocked. Turn off CAPTCHA in HubSpot or use an embed.');
          } else {
            showResult(form, false, text || `Error ${res.status}`);
          }
          if (debug) console.warn('[HS] error', res.status, text);
          if (btn) btn.disabled = false;
        }
      } catch (err) {
        showResult(form, false, 'Network error. Please try again.');
        if (debug) console.error('[HS] network error', err);
        if (btn) btn.disabled = false;
      }
    });
  });
})();
