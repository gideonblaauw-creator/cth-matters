<script>
document.addEventListener("DOMContentLoaded", function () {
    let e = window.matchMedia("(pointer: coarse)").matches;
    if (e) return;
    let o = document.querySelector(".custom-cursor");
    if (!o) return;

    gsap.set(o, { width: 16, height: 16, opacity: 1, backgroundColor: "#0399b9" });

    document.addEventListener("mousemove", (e) => {
        gsap.to(o, { x: e.clientX - 8, y: e.clientY - 8, duration: 0.15, ease: "power2.out" });
    });

    let t = document.querySelectorAll(
        ".button, .button-secondary, .nav-dropdown-test, .drop-header-link, .client-logos-background, .tab-item-products, .industries-card, .blog-cards, .arrow-keys, .footer-link, .contact-input-field, .form-button-submit, .linkedin-link, .report-card, .search-field, .sort-dropdown, .news-link-block, .blog-link-block, .pagination-number, .social-btn, .contact-message-area, .resume-upload, .hover-beacon"
    );

    t.forEach((el) => {
        el.addEventListener("mouseenter", () => {
            if (el.classList.contains("button")) {
                gsap.to(o, { width: 10, height: 10, backgroundColor: "#fff", duration: 0.2, ease: "power2.out" });
            } else {
                gsap.to(o, { width: 10, height: 10, backgroundColor: "#0399b9", duration: 0.2, ease: "power2.out" });
            }
        });

        el.addEventListener("mouseleave", () => {
            gsap.to(o, { width: 16, height: 16, backgroundColor: "#0399b9", duration: 0.2, ease: "power2.out" });
        });
    });
});
</script>


