  document.addEventListener('DOMContentLoaded', () => {

    //---- Skip to <main> backup if #main anchor link isn't set ----
    const skipLinkEle = document.getElementById('skip-link');
    if (skipLinkEle) {
      skipLinkEle.addEventListener('click', handleSkipLink);
      skipLinkEle.addEventListener('keydown', handleSkipLink);
    }

    /* Switch Nav's color mode when scrolling through light and dark sections */
    const navAttr = "data-wf--nav--settings-color-mode";
    const variantClass = "w-variant-b23b0bfb-3285-ab6f-754f-ce412db82d06";
    const nav = document.querySelector(`[${navAttr}]`);
    const sections = document.querySelectorAll('[data-wf--section--settings-color-mode]');
    const variantTargets = [
      document.querySelector(".nav"),
      document.querySelector(".container.cc-nav"),
      document.querySelector(".nav-logo_link"),
      document.querySelector(".nav-link.cc-sign-in")
    ].filter(Boolean);

    if (nav && sections.length) {
      function setVariantMode(isDark) {
        const navMode = isDark ? "invert" : "base";
        nav.setAttribute(navAttr, navMode);
        variantTargets.forEach(el => {
          el.classList.toggle(variantClass, isDark);
        });
      }
      function updateNavMode() {
        let activeSection = null;
        sections.forEach(section => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= 0 && rect.bottom > 0) activeSection = section;
        });
        if (!activeSection) return;
        setVariantMode(["dark", "vantablack", "dark-grey"].includes(
          activeSection.getAttribute("data-wf--section--settings-color-mode")
        ));
      }
      let ticking = false;
      window.addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { updateNavMode(); ticking = false; });
      });
      updateNavMode();
    }

    // Hide notification banner for user session
    const banner = document.querySelector('[data-banner="banner"]');
    const closeButton = document.querySelector('[data-banner="close button"]');
    if (banner && closeButton) {
      if (localStorage.getItem('bannerClosed') === 'true') banner.style.display = 'none';
      closeButton.addEventListener('click', () => {
        banner.style.display = 'none';
        localStorage.setItem('bannerClosed', 'true');
      });
    }

  });

  function handleSkipLink(e) {
    if (e.type === 'keydown' && e.key !== 'Enter') return;
    e.preventDefault();
    const target = document.querySelector('main');
    target.setAttribute('tabindex', '-1');
    target.focus();
  }
