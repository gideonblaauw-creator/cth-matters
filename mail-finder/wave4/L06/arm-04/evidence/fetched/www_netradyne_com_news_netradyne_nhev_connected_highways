    if (!richtext) {
      cta.style.display = 'none';
      return;
    }

    // Top-level blocks only, and never the CTA itself if it's authored inside.
    var blocks = Array.from(richtext.children).filter(function (el) {
      return el !== cta && el.textContent.trim().length + el.querySelectorAll('img').length > 0;
    });

    if (blocks.length < 3) {
      cta.style.display = 'none';
      return;
    }

    var total = blocks.reduce(function (sum, el) {
      return sum + el.textContent.trim().length;
    }, 0);

    var running = 0;
    var index = blocks.length - 1;
    for (var i = 0; i < blocks.length; i++) {
      running += blocks[i].textContent.trim().length;
      if (running >= total * TARGET_RATIO) {
        index = i + 1; // insert *after* the block that crosses the line
        break;
      }
    }

    // Don't orphan a heading from the content it introduces.
    while (index > 0 && /^H[1-6]$/.test((blocks[index - 1] || {}).tagName || '')) {
      index--;
    }

    // Keep it inside the article: never first, never dead last.
    if (index < 1) index = 1;
    if (index > blocks.length - 1) index = blocks.length - 1;

    cta.style.display = '';
    richtext.insertBefore(cta, blocks[index]);
  });
</script>
