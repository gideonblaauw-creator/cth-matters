<!-- Consolidated UTM Tracking + HubSpot Form Initialization -->
<script>
(function () {
  'use strict';

  // ============================================================
  // CONFIGURATION
  // ============================================================
  //
  const UTM_MAP = {
    utm_source:   'utm_source',
    utm_medium:   'utm_medium',
    utm_campaign: 'utm_campaign',
    utm_content:  'utm_content',
    utm_term:     'utm_term',
  };

  const UTM_KEYS = Object.keys(UTM_MAP);
  const SUBMISSION_FIELD = 'submission_page_url';

  // Storage keys for first-touch and last-touch attribution
  const STORE_LAST  = 'utm_cache_last_v2';
  const STORE_FIRST = 'utm_cache_first_v2';

  // ============================================================
  // UTM STORAGE HELPERS
  // ============================================================

  function loadStore(key) {
    try { return JSON.parse(sessionStorage.getItem(key) || '{}'); }
    catch { return {}; }
  }

  function saveStore(key, obj) {
    try { sessionStorage.setItem(key, JSON.stringify(obj || {})); }
    catch { /* sessionStorage unavailable — degrade gracefully */ }
  }

  // ============================================================
  // 1. CAPTURE UTMs FROM LANDING URL
  // ============================================================
  // Runs immediately on every page load. If the URL has UTM params,
  // store them for later use when the user reaches a form page.

  function captureUtmsFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const last  = loadStore(STORE_LAST);
    const first = loadStore(STORE_FIRST);
    let lastChanged  = false;
    let firstChanged = false;

    UTM_KEYS.forEach(function (key) {
      const val = params.get(key);
      if (!val) return;

      // Always update last-touch (most recent campaign)
      if (last[key] !== val) {
        last[key] = val;
        lastChanged = true;
      }

      // Only set first-touch if it was never captured
      if (first[key] == null) {
        first[key] = val;
        firstChanged = true;
      }
    });

    if (lastChanged)  saveStore(STORE_LAST, last);
    if (firstChanged) saveStore(STORE_FIRST, first);
  }

  // Run capture immediately — don't wait for DOMContentLoaded
  captureUtmsFromUrl();

  // ============================================================
  // 2. DECORATE INTERNAL LINKS WITH UTMs
  // ============================================================
  // Appends cached UTMs to all internal <a> links so the params
  // persist in the URL as users navigate. Handles both initial
  // page links and dynamically added links (modals, tabs, etc.)

  function decorateLink(anchor) {
    var cache = loadStore(STORE_LAST);
    var href  = anchor.getAttribute('href');
    if (!href || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('#')) return;

    try {
      var url = new URL(href, location.origin);
      if (url.origin !== location.origin) return; // Skip external links

      var changed = false;
      UTM_KEYS.forEach(function (key) {
        if (!url.searchParams.get(key) && cache[key]) {
          url.searchParams.set(key, cache[key]);
          changed = true;
        }
      });

      if (changed) {
        anchor.setAttribute('href', url.pathname + url.search + url.hash);
      }
    } catch (e) { /* malformed URL — skip */ }
  }

  function decorateAllLinks(root) {
    var cache = loadStore(STORE_LAST);
    // Only bother if we have UTMs to decorate with
    var hasUtms = UTM_KEYS.some(function (k) { return !!cache[k]; });
    if (!hasUtms) return;

    var links = (root || document).querySelectorAll('a[href]');
    links.forEach(decorateLink);
  }

  // ============================================================
  // 3. FORM FIELD INJECTION
  // ============================================================
  // Creates/populates hidden fields in HubSpot forms with UTM
  // values and the current page URL.

  function ensureHiddenInput(formEl, name) {
    var input = formEl.querySelector('input[name="' + name + '"]');
    if (!input) {
      input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      formEl.appendChild(input);
    }
    return input;
  }

  function fillTrackingFields(scopeEl) {
    var formEl = scopeEl.querySelector('form') || scopeEl;
    if (!formEl || formEl.tagName !== 'FORM') return;

    var params = new URLSearchParams(window.location.search);
    var last   = loadStore(STORE_LAST);

    // Fill UTM fields: prefer URL value → stored last-touch → empty
    UTM_KEYS.forEach(function (key) {
      var val   = params.get(key) || last[key] || '';
      var name  = UTM_MAP[key];
      var input = ensureHiddenInput(formEl, name);
      if (val) input.value = val;
    });

    // Always set submission page URL
    ensureHiddenInput(formEl, SUBMISSION_FIELD).value = window.location.href;
  }

  // ============================================================
  // 4. HUBSPOT FORM INITIALIZATION (.wf-hs pattern)
  // ============================================================
  // Finds all .wf-hs wrapper elements and creates HubSpot forms
  // inside them. Handles both elements present at page load and
  // elements added dynamically.

  var INIT_ATTR   = 'data-wf-hs-init';
  var BOUND_FORMS = new WeakSet();

  function bindFormTracking(form, scopeEl) {
    if (BOUND_FORMS.has(form)) return;
    BOUND_FORMS.add(form);

    // Fill fields immediately
    fillTrackingFields(scopeEl);

    // Re-fill on submit in case user navigated or values changed
    form.addEventListener('submit', function () {
      fillTrackingFields(scopeEl);
    });
  }

  function createFormForHolder(holder) {
    if (!holder || holder.getAttribute(INIT_ATTR) === '1') return;

    var portalId = holder.dataset.hsPortal;
    var formId   = holder.dataset.hsForm;
    var region   = holder.dataset.hsRegion || 'na2';
    var target   = '#' + holder.id;

    if (!portalId || !formId || !holder.id) return;

    holder.setAttribute(INIT_ATTR, '1');

    hbspt.forms.create({
      portalId: portalId,
      formId:   formId,
      region:   region,
      target:   target,
      css:      '',
      cssClass: 'wf-hs__form',
      onFormReady: function ($form) {
        var scopeEl =
          ($form && $form.get && $form.get(0)) ||
          ($form && $form[0]) ||
          holder;

        var domForm = scopeEl.querySelector('form');
        if (domForm) bindFormTracking(domForm, scopeEl);
      }
    });
  }

  function scanAndCreateAllForms() {
    var holders = document.querySelectorAll('.wf-hs[data-hs-portal][data-hs-form]');
    holders.forEach(createFormForHolder);
  }

  // Wait for HubSpot embed script to load
  function waitForHubSpot(maxMs, everyMs) {
    maxMs   = maxMs   || 15000;
    everyMs = everyMs || 100;

    return new Promise(function (resolve, reject) {
      var start = performance.now();
      (function check() {
        if (window.hbspt && window.hbspt.forms && window.hbspt.forms.create) {
          return resolve();
        }
        if (performance.now() - start > maxMs) {
          return reject(new Error('HubSpot embed did not load within ' + maxMs + 'ms'));
        }
        setTimeout(check, everyMs);
      })();
    });
  }

  // ============================================================
  // 5. MUTATION OBSERVER — Unified watcher for forms + links
  // ============================================================
  // Single observer handles:
  //   - New .wf-hs holders added to the page → initialize form
  //   - New <form> elements injected by HubSpot → bind tracking
  //   - New <a> links added dynamically → decorate with UTMs

  function startObserver() {
    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(function (node) {
          if (!(node instanceof HTMLElement)) return;

          // Check for new .wf-hs holders
          if (node.matches && node.matches('.wf-hs[data-hs-portal][data-hs-form]')) {
            createFormForHolder(node);
          }
          var innerHolders = node.querySelectorAll && node.querySelectorAll('.wf-hs[data-hs-portal][data-hs-form]');
          if (innerHolders) innerHolders.forEach(createFormForHolder);

          // Check for new HubSpot forms (injected after holder init)
          var newForms = [];
          if (node.matches && node.matches('.wf-hs form')) {
            newForms.push(node);
          }
          var innerForms = node.querySelectorAll && node.querySelectorAll('.wf-hs form');
          if (innerForms) innerForms.forEach(function (f) { newForms.push(f); });

          newForms.forEach(function (form) {
            var scopeEl = form.closest('.wf-hs') || form;
            bindFormTracking(form, scopeEl);
          });

          // Also check for standalone HubSpot forms (not in .wf-hs wrappers)
          // This catches forms created by HubSpot's own embed methods
          var standaloneForms = [];
          if (node.matches && node.matches('form.hs-form')) {
            standaloneForms.push(node);
          }
          var innerStandalone = node.querySelectorAll && node.querySelectorAll('form.hs-form');
          if (innerStandalone) innerStandalone.forEach(function (f) { standaloneForms.push(f); });

          standaloneForms.forEach(function (form) {
            bindFormTracking(form, form);
          });

          // Decorate any new links with UTMs
          if (node.tagName === 'A' && node.hasAttribute('href')) {
            decorateLink(node);
          }
          var innerLinks = node.querySelectorAll && node.querySelectorAll('a[href]');
          if (innerLinks) innerLinks.forEach(decorateLink);
        });
      });
    });

    observer.observe(document.documentElement, { childList: true, subtree: true });
  }

  // ============================================================
  // 6. BOOT SEQUENCE
  // ============================================================
  
  function boot() {
    // Decorate links immediately — don't wait for HubSpot
    decorateAllLinks();
    startObserver(); // Watch for dynamic content (also decorates new links)
  
    // HubSpot form init is separate and can wait
    waitForHubSpot()
      .then(function () {
        scanAndCreateAllForms();
      })
      .catch(function () {
        // HubSpot failed — links and observer already running, no action needed
      });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

})();
