<script>
(function () {
  var VERTICALS = {
    trucking:       { path: ['trucking'],                                            utm: ['trucking'] },
    distribution:   { path: ['distribution', 'food-beverage', 'oil-gas'],             utm: ['distribution'] },
    waste:          { path: ['waste', 'recycling'],                                   utm: ['waste', 'recycling'] },
    homeCommercial: { path: ['home-commercial', 'plumbing', 'pest-control', 'hvac', 'landscaping', 'tree-service'], utm: ['home-commercial', 'hvac'] },
    construction:   { path: ['construction'],                                         utm: ['construction'] }
  };

  function matchesAny(value, keywords) {
    if (!value) return false;
    value = value.toLowerCase();
    return keywords.some(function (kw) { return value.indexOf(kw) > -1; });
  }

  var path = window.location.pathname || '';
  var params = new URLSearchParams(window.location.search);
  var utmBlob = [params.get('utm_content'), params.get('utm_campaign'), params.get('utm_term')].join(' ');
  var referrer = document.referrer || '';

  var detected = null;
  Object.keys(VERTICALS).some(function (key) {
    var rules = VERTICALS[key];
    if (matchesAny(path, rules.path) || matchesAny(utmBlob, rules.utm) || matchesAny(referrer, rules.path)) {
      detected = key;
      return true;
    }
    return false;
  });

  if (detected) {
    try { sessionStorage.setItem('nr_vertical', detected); } catch (e) {}
  }
})();
</script>
