<!-- ✅ Updated GeoIP Redirect for Privacy Policy -->
<!-- Automatically redirects users to their country-specific privacy policy page based on their location -->
<!-- Respects user's manual locale selection for 24 hours to prevent redirect loops -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  // Map of country codes to their localized URL paths
  const localeMap = {
    "US": "",              // US uses root path (no prefix)
    "GB": "/uk",           // United Kingdom
    "CA": "/ca-en",        // Canada (English)
    "CA_FR": "/ca-fr",     // Canada (French)
    "MX": "/mx",           // Mexico
    "DE": "/de",           // Germany
    "NL": "/nl",           // Netherlands
    "JP": "/jp",           // Japan
    "IN": "/in",           // India
    "AE": "/ae-ar",        // United Arab Emirates (Arabic)
    "SA": "/sa-ar"         // Saudi Arabia (Arabic)
  };

  // Check if user manually selected a locale within the last 24 hours
  const selectedLocale = localStorage.getItem("userSelectedLocale");
  const selectedAt = localStorage.getItem("localeSelectedAt");
  const TWENTY_FOUR_HOURS = 24 * 60 * 60 * 1000;

  if (selectedLocale && selectedAt && (Date.now() - selectedAt) < TWENTY_FOUR_HOURS) {
    // User recently selected a locale manually, skip auto-redirect
    return;
  }

  // Clear stale locale data if expired
  localStorage.removeItem("userSelectedLocale");
  localStorage.removeItem("localeSelectedAt");

  // Call free GeoIP API to detect user's country
  fetch("https://ipapi.co/json/")
    .then(response => response.json())
    .then(data => {
      const countryCode = data.country_code;
      const countryLang = data.languages ? data.languages.split(",")[0] : "";

      // Look up the appropriate locale path for this country
      let targetPath = localeMap[countryCode];

      // Special case: Canadian users speaking French get French site
      if (countryCode === "CA" && countryLang.startsWith("fr")) {
        targetPath = localeMap["CA_FR"];
      }

      // If country not in our map, do nothing (stay on current page)
      if (typeof targetPath === "undefined") return;

      const currentPath = window.location.pathname;

      // Only redirect if on privacy policy page AND not already on correct locale version
      if (currentPath.startsWith("/legal/privacy-policy") && !currentPath.startsWith(targetPath + "/legal/privacy-policy")) {
        const redirectUrl = targetPath + "/legal/privacy-policy";
        window.location.href = redirectUrl || "/legal/privacy-policy";
      }
    })
    .catch(err => console.log("GeoIP lookup failed:", err));

  // Listen for manual locale selection via country picker links
  // When user clicks a locale link, remember their choice for 24 hours
  document.querySelectorAll(".cc-locale").forEach(link => {
    link.addEventListener("click", function () {
      const selectedLocale = this.getAttribute("hreflang");
      localStorage.setItem("userSelectedLocale", selectedLocale);
      localStorage.setItem("localeSelectedAt", Date.now());
    });
  });
});
</script>

