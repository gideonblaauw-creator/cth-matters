<!-- Start/Stop Videos when opening/closing modal -->
<script src="https://cdn.jsdelivr.net/npm/player.js@latest/dist/player.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll('iframe').forEach((embed) => {
      const player = new playerjs.Player(embed);
      player.on('ready', function () {
        const modal = embed.closest('.modal-full_component');
        if (!modal) return;

        // Toggle is a sibling of the modal inside the same parent
        const toggleBtn = modal.parentElement?.querySelector('.modal-full_toggle');
        const closeBtn = modal.querySelector('.modal_close-button');
        const dialog = modal.querySelector('dialog') || modal.closest('dialog');

        // ▶️ Autoplay when THIS modal opens
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            setTimeout(() => player.play(), 100);
          });
        }

        // ⏸️ Pause on close button
        if (closeBtn) {
          closeBtn.addEventListener('click', () => player.pause());
        }

        // ⏸️ Pause on backdrop click
        if (dialog) {
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) player.pause();
          });
        }
      });
    });

    // HTML5 <video> elements — scoped to each modal's parent
    document.querySelectorAll('.modal-full_component').forEach((modal) => {
      const toggleBtn = modal.parentElement?.querySelector('.modal-full_toggle');
      const closeBtn = modal.querySelector('.modal_close-button');

      // ▶️ Autoplay
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          setTimeout(() => {
            modal.querySelectorAll('video').forEach(v => v.play());
          }, 100);
        });
      }

      // ⏸️ Pause + reset on close
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          modal.querySelectorAll('video').forEach(v => {
            v.pause();
            v.currentTime = 0;
          });
        });
      }
    });

    // ⏸️ Pause HTML5 videos on backdrop click
    document.querySelectorAll('dialog').forEach((dialog) => {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          dialog.querySelectorAll('video').forEach(v => {
            v.pause();
            v.currentTime = 0;
          });
        }
      });
    });

    /* Body overflow — lock on any toggle, restore on any close */
    document.querySelectorAll('.modal-full_toggle').forEach((btn) => {
      btn.addEventListener('click', () => document.body.style.overflow = 'hidden');
    });
    document.querySelectorAll('.modal_close-button').forEach((btn) => {
      btn.addEventListener('click', () => document.body.style.overflow = 'auto');
    });

  });
