		<script async>
			document.addEventListener("DOMContentLoaded", function() {

				const countElements = document.querySelectorAll(".count-element");
				const wrapper = document.querySelector('.text-stats.stats .wrapper');

				const observer = new IntersectionObserver(entries => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							countElements.forEach(element => {
								const targetCount = element.getAttribute("data-count");
								animateCount(element, targetCount);
							});
							observer.unobserve(wrapper);
						}
					});
				}, {
					threshold: 0.10,
					rootMargin: '0px 0px -40% 0px'
				});

				observer.observe(wrapper);

				function animateCount(element, targetCount) {
					let currentCount = 0;
					const duration = 1800;
					const interval = 20;
					let step = 0;
					if(!element.getAttribute('data-direction')){
						step = (targetCount / duration) * interval;
					}else{
						currentCount = element.getAttribute('data-start');
						step = (element.getAttribute('data-start') / duration) * interval;
						console.log(step);
					}

					const updateCount = function() {
						if(!element.getAttribute('data-direction')){
							if (currentCount < targetCount) {
								if (targetCount % 1 != 0) {
									element.textContent = (currentCount).toFixed(2);
								} else {
									element.textContent = Math.round(currentCount);
								}
								currentCount += step;
								setTimeout(updateCount, interval);
							} else {
								element.textContent = targetCount;
							}
						}else{							
							if (currentCount > targetCount) {
								if (targetCount % 1 != 0) {
									element.textContent = (currentCount).toFixed(2);
								} else {
									element.textContent = Math.round(currentCount);
								}
								currentCount -= step;
								setTimeout(updateCount, interval);
							} else {
								element.textContent = targetCount;
							}
						}
					};

					updateCount();
				}

			});

		</script>

	
