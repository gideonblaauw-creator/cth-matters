      <a href="programs.html">Programs</a>
      <a href="career.html">Career</a>
      <a href="blog.html">Blog</a>
    </nav>
  </div>

  <!-- Hero Section - BigTitle -->
  <section class="px-[8.33%] mx-auto w-full pt-3 sm:pt-6 md:pt-10 lg:pt-[65px] 2xl:pt-[92px] pb-16 sm:pb-20 md:pb-24 lg:pb-[123px] 2xl:pb-[174px] bg-bg-main">
    <div class="flex flex-col items-center justify-center">
      <span class="font-manrope font-semibold uppercase text-[9px] sm:text-sm md:text-base lg:text-xl 2xl:text-3xl tracking-wider text-primary mb-6 sm:mb-10 md:mb-12 lg:mb-[55px] 2xl:mb-[78px]">
        Blog
      </span>
      <h1 class="block text-center mx-auto lg:max-w-4xl 2xl:max-w-[1224px]">
        <span class="font-bison text-5xl sm:text-6xl md:text-7xl lg:text-9xl 2xl:text-[180px] text-primary uppercase tracking-wide leading-9 sm:leading-[50px] md:leading-[70px] lg:leading-[112px] 2xl:leading-[158.76px]">Read what </span>
        <span class="font-bison text-5xl sm:text-6xl md:text-7xl lg:text-9xl 2xl:text-[180px] highlight-text uppercase tracking-wide leading-9 sm:leading-[50px] md:leading-[70px] lg:leading-[112px] 2xl:leading-[158.76px]">inspires us</span>
      </h1>
      <!-- Arrow Down -->
      <svg class="mt-14 sm:mt-16 md:mt-20 lg:mt-[65px] 2xl:mt-[92px] text-primary w-[22.48px] h-[30.58px] sm:w-[35px] sm:h-[48px] md:w-[42px] md:h-[58px] lg:w-[49.35px] lg:h-[67.14px] 2xl:w-[69.37px] 2xl:h-[94.37px]" viewBox="0 0 70 95" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M35 0V90M35 90L5 60M35 90L65 60" stroke="currentColor" stroke-width="3"/>
      </svg>
    </div>
  </section>

  <!-- Filters -->
