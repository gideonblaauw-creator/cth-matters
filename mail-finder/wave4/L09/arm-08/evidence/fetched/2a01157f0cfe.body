<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog - MAYA Capital</title>
  <meta name="description" content="Read what inspires MAYA Capital - insights on investments and entrepreneurship in Latin America.">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="favicon.svg">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#2d4be0',
            secondary: '#222933',
            tertiary: '#22398d',
            neutral: '#f9f9f9',
            'bg-main': '#eaeaea',
            'pink-accent': '#fcc5cd',
          },
          fontFamily: {
            bison: ['Bison', 'sans-serif'],
            manrope: ['Manrope', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="font-manrope bg-bg-main">

  <!-- Header -->
  <header class="bg-bg-main">
    <div class="flex justify-between items-center w-full px-6 lg:px-0 lg:w-[83.23%] mx-auto py-5 sm:py-8 md:py-10 lg:py-16">
      <a href="index.html" aria-label="Maya Capital">
        <img src="images/supabase/a73914d0-15cc-47e8-8a78-d33823039e02.png" alt="Maya Capital" class="h-5 sm:h-6 md:h-6 lg:h-7 2xl:h-10">
      </a>
      <button class="hamburger" id="menuBtn" aria-label="Menu">
        <span class="bg-primary"></span>
        <span class="bg-primary"></span>
        <span class="bg-primary"></span>
      </button>
    </div>
  </header>

  <!-- Fullscreen Menu -->
  <div class="fullscreen-menu" id="fullscreenMenu">
    <div class="fullscreen-menu-header">
      <a href="index.html" aria-label="Maya Capital">
