      </a>
      <button class="hamburger" id="closeMenu" aria-label="Close Menu">
        <span class="bg-white rotate-45 translate-y-[7px]"></span>
        <span class="bg-white opacity-0"></span>
        <span class="bg-white -rotate-45 -translate-y-[7px]"></span>
      </button>
    </div>
    <nav>
      <a href="about-us.html">About us</a>
