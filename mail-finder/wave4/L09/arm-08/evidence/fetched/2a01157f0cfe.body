        <button class="blog-filter-btn filter-btn active text-[8px] sm:text-xs md:text-sm lg:text-sm 2xl:text-base" data-filter="all">All</button>
        <button class="blog-filter-btn filter-btn text-[8px] sm:text-xs md:text-sm lg:text-sm 2xl:text-base" data-filter="investments">Investments</button>
        <button class="blog-filter-btn filter-btn text-[8px] sm:text-xs md:text-sm lg:text-sm 2xl:text-base" data-filter="news">News</button>
        <button class="blog-filter-btn filter-btn text-[8px] sm:text-xs md:text-sm lg:text-sm 2xl:text-base" data-filter="articles">Articles</button>
