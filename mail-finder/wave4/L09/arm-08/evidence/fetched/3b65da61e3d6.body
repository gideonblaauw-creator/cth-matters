<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio - MAYA Capital</title>
  <meta name="description" content="Discover MAYA Capital's portfolio of innovative startups across Latin America.">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="favicon.svg">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#2d4be0',
            secondary: '#222933',
            tertiary: '#22398d',
            neutral: '#f9f9f9',
            'bg-main': '#eaeaea',
            'pink-accent': '#fcc5cd',
          },
          fontFamily: {
            bison: ['Bison', 'sans-serif'],
            manrope: ['Manrope', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="font-manrope bg-bg-main">

  <!-- Header -->
  <header class="bg-bg-main">
    <div class="flex justify-between items-center w-full px-6 lg:px-0 lg:w-[83.23%] mx-auto py-5 sm:py-8 md:py-10 lg:py-16">
      <a href="index.html" aria-label="Maya Capital">
        <img src="images/supabase/a73914d0-15cc-47e8-8a78-d33823039e02.png" alt="Maya Capital" class="h-5 sm:h-6 md:h-6 lg:h-7 2xl:h-10">
      </a>
      <button class="hamburger" id="menuBtn" aria-label="Menu">
        <span class="bg-primary"></span>
        <span class="bg-primary"></span>
        <span class="bg-primary"></span>
      </button>
    </div>
  </header>

  <!-- Fullscreen Menu -->
  <div class="fullscreen-menu" id="fullscreenMenu">
    <div class="fullscreen-menu-header">
      <a href="index.html" aria-label="Maya Capital">
        <img src="images/supabase/ce106e89-e920-43e4-bc2f-530da75d149e.png" alt="Maya Capital" class="h-5 sm:h-6 md:h-6 lg:h-7 2xl:h-10">
      </a>
      <button class="hamburger" id="closeMenu" aria-label="Close Menu">
        <span class="bg-white rotate-45 translate-y-[7px]"></span>
        <span class="bg-white opacity-0"></span>
        <span class="bg-white -rotate-45 -translate-y-[7px]"></span>
      </button>
    </div>
    <nav>
      <a href="about-us.html">About us</a>
      <a href="team.html">Team</a>
      <a href="portfolio.html">Portfolio</a>
      <a href="programs.html">Programs</a>
      <a href="career.html">Career</a>
      <a href="blog.html">Blog</a>
    </nav>
  </div>

  <!-- BigTitle Section -->
  <section class="bg-bg-main px-[8.33%] mx-auto w-full pt-3 sm:pt-6 md:pt-10 lg:pt-[65px] 2xl:pt-[92px] pb-16 sm:pb-20 md:pb-24 lg:pb-[123px] 2xl:pb-[174px]">
    <div class="flex flex-col items-center justify-center">
      <span class="font-manrope font-semibold uppercase text-[9px] sm:text-sm md:text-base lg:text-xl 2xl:text-3xl tracking-wider text-primary mb-6 sm:mb-10 md:mb-12 lg:mb-[55px] 2xl:mb-[78px]">
        Our portfolio
      </span>
      <h1 class="text-center">
        <span class="highlight-text font-bison text-5xl sm:text-6xl md:text-7xl lg:text-9xl 2xl:text-[180px] uppercase tracking-wide leading-9 sm:leading-[50px] md:leading-[70px] lg:leading-[112px] 2xl:leading-[158.76px]">Founders guide us </span>
        <span class="font-bison text-5xl sm:text-6xl md:text-7xl lg:text-9xl 2xl:text-[180px] text-primary uppercase tracking-wide leading-9 sm:leading-[50px] md:leading-[70px] lg:leading-[112px] 2xl:leading-[158.76px]">We back them</span>
      </h1>
      <!-- Arrow Down -->
      <svg class="mt-14 sm:mt-16 md:mt-20 lg:mt-[65px] 2xl:mt-[92px] text-primary w-[22.48px] h-[30.58px] sm:w-[35px] sm:h-[48px] md:w-[42px] md:h-[58px] lg:w-[49.35px] lg:h-[67.14px] 2xl:w-[69.37px] 2xl:h-[94.37px]" viewBox="0 0 70 95" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M35 0V90M35 90L5 60M35 90L65 60" stroke="currentColor" stroke-width="3"/>
      </svg>
    </div>
  </section>

  <!-- TableInfo Section - Company List -->
  <section class="bg-bg-main">
    <div class="px-[8.33%] lg:px-0 flex flex-col pt-[50px] sm:pt-[60px] md:pt-[75px] lg:pt-[91px] 2xl:pt-32 pb-10 sm:pb-16 md:pb-20 lg:pb-28 2xl:pb-[158px] lg:max-w-[66.67%] mx-auto w-full">

      <!-- Header with Title and Filters -->
      <div class="flex flex-col items-center justify-center lg:flex-row lg:justify-between border-b lg:border-b-2 border-primary lg:items-end pb-1 sm:pb-2 md:pb-3 lg:py-[22px] 2xl:py-8 gap-6 sm:gap-5 md:gap-4 lg:gap-0">
        <h2>
          <span class="font-bison text-[32px] sm:text-4xl md:text-5xl lg:text-7xl 2xl:text-[100px] font-bold text-primary uppercase">MEET THE </span>
          <span class="highlight-text font-bison text-[32px] sm:text-4xl md:text-5xl lg:text-7xl 2xl:text-[100px] font-bold uppercase">MAYAns</span>
        </h2>
        <div class="flex gap-2 sm:gap-3 md:gap-3 lg:gap-4 2xl:gap-6 w-full justify-end lg:w-[35%]">
          <select id="countryFilter" class="bg-white border border-primary text-primary px-2 sm:px-3 md:px-3 lg:px-4 py-1 sm:py-1.5 md:py-1.5 lg:py-2 text-[8px] sm:text-xs md:text-sm lg:text-sm 2xl:text-base font-semibold uppercase cursor-pointer rounded-none">
            <option value="all">Country</option>
            <option value="Brazil">Brazil</option>
            <option value="Mexico">Mexico</option>
            <option value="Colombia">Colombia</option>
            <option value="Chile">Chile</option>
            <option value="Argentina">Argentina</option>
          </select>
          <select id="sectorFilter" class="bg-white border border-primary text-primary px-2 sm:px-3 md:px-3 lg:px-4 py-1 sm:py-1.5 md:py-1.5 lg:py-2 text-[8px] sm:text-xs md:text-sm lg:text-sm 2xl:text-base font-semibold uppercase cursor-pointer rounded-none">
            <option value="all">Sector</option>
            <option value="FinTech">FinTech</option>
            <option value="HealthTech">HealthTech</option>
            <option value="SaaS B2B">SaaS B2B</option>
            <option value="AgTech">AgTech</option>
            <option value="EdTech">EdTech</option>
            <option value="FoodTech">FoodTech</option>
            <option value="HR Tech">HR Tech</option>
            <option value="Logistics">Logistics</option>
          </select>
        </div>
      </div>

      <!-- Table Header -->
      <div class="py-1 sm:py-1.5 md:py-2 lg:py-0 flex items-center border-b border-black">
        <span class="font-manrope font-bold text-[5px] sm:text-[7px] md:text-[9px] lg:text-xs 2xl:text-base lg:leading-7 2xl:leading-10 text-black tracking-widest uppercase flex-1">
          Company name
        </span>
        <span class="font-manrope font-bold text-[5px] sm:text-[7px] md:text-[9px] lg:text-xs 2xl:text-base lg:leading-7 2xl:leading-10 text-black tracking-widest uppercase" style="flex: 3;">
          Short Description
        </span>
      </div>

      <!-- Company List -->
      <div class="flex flex-col max-h-96 sm:max-h-[320px] md:max-h-[340px] lg:max-h-[355px] 2xl:max-h-[500px] overflow-y-auto scrollbar-variant" id="companyList">

        <!-- Alice -->
        <div class="company-row border-b border-black" data-country="Brazil" data-sector="HealthTech,InsureTech">
          <details class="collapse-table">
            <summary class="flex items-center py-2 sm:py-3 md:py-3.5 lg:py-[18px] 2xl:py-[26px] cursor-pointer hover:bg-primary transition-all duration-300 list-none">
              <span class="font-manrope text-[9px] sm:text-sm md:text-base lg:text-xl 2xl:text-3xl leading-3 sm:leading-5 md:leading-6 lg:leading-7 2xl:leading-10 text-black collapse-text flex-1 pl-1 sm:pl-2 md:pl-4 lg:pl-6">
                Alice
              </span>
              <div class="flex justify-between items-center pr-3 sm:pr-4 md:pr-5 lg:pr-7 2xl:pr-10 gap-6 sm:gap-4 md:gap-3 lg:gap-0" style="flex: 3;">
                <span class="font-manrope text-[6.5px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl leading-none sm:leading-4 md:leading-5 lg:leading-[22px] 2xl:leading-8 text-black collapse-text max-w-lg short-description transition-opacity duration-300">
                  Health insurance combined with primary care, delivered digitally and in-person.
                </span>
                <div class="relative min-w-[24px] min-h-6 sm:min-w-[32px] sm:min-h-8 md:min-w-[40px] md:min-h-10 lg:w-[52px] lg:h-[52px] 2xl:w-[73px] 2xl:h-[73px]">
                  <svg class="collapse-icon w-full h-full text-black collapse-text" data-plus viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v8M8 12h8"/>
                  </svg>
                  <svg class="collapse-icon w-full h-full text-black collapse-text" data-minus viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 12h8"/>
                  </svg>
                </div>
              </div>
            </summary>
            <div class="collapse-content bg-primary px-3 sm:px-5 md:px-7 lg:px-11 2xl:px-16 py-4 sm:py-5 md:py-6 lg:py-8">
              <img src="https://deco-sites-assets.s3.sa-east-1.amazonaws.com/maya/e0295dba-cbc6-4d85-89ad-8a61bc53096a/Alice-Logo-preto.png" alt="Alice" class="h-8 sm:h-9 md:h-10 lg:h-12 object-contain mb-4 invert">
              <div class="flex justify-between gap-4 2xl:gap-6 mt-2 sm:mt-3 md:mt-4 lg:mt-6 2xl:mt-9 mb-3 sm:mb-5 md:mb-7 lg:mb-10 2xl:mb-14">
                <div><span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block">Sector</span><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">HealthTech, InsureTech</span></div>
                <div><span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block">Website</span><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">alice.com.br</span></div>
                <div><span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block">Co-Investors</span><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">Softbank, Kaszek, ThornTree Capital Partners, Canary</span></div>
              </div>
              <p class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">Health insurance combined with primary care, delivered digitally and in-person. Alice is reinventing the health insurance industry in Brazil.</p>
              <div class="mt-3 sm:mt-5 md:mt-7 lg:mt-10 2xl:mt-14">
                <span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block mb-1 sm:mb-2 md:mb-2 lg:mb-3 2xl:mb-4">Founders</span>
                <div class="flex flex-wrap gap-3 sm:gap-4 md:gap-6 lg:gap-[34px] 2xl:gap-12">
                  <div class="flex items-center gap-2 2xl:gap-3 w-2/5 lg:w-auto"><img src="images/supabase/3fc815a3-10df-4d44-99a2-518fbd1a4067.jpg" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 lg:w-[71px] lg:h-[71px] 2xl:w-[100px] 2xl:h-[100px] rounded-full object-cover"><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 max-w-16 sm:max-w-20 md:max-w-24 lg:max-w-28 tracking-wider">André Florence</span></div>
                  <div class="flex items-center gap-2 2xl:gap-3 w-2/5 lg:w-auto"><img src="images/supabase/ae231ca3-5188-415c-a05c-1676f7347485.jpg" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 lg:w-[71px] lg:h-[71px] 2xl:w-[100px] 2xl:h-[100px] rounded-full object-cover"><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 max-w-16 sm:max-w-20 md:max-w-24 lg:max-w-28 tracking-wider">Guilherme Azevedo</span></div>
                  <div class="flex items-center gap-2 2xl:gap-3 w-2/5 lg:w-auto"><img src="images/supabase/ff8f4ce6-796a-432e-af6b-288b2fec7919.jpg" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 lg:w-[71px] lg:h-[71px] 2xl:w-[100px] 2xl:h-[100px] rounded-full object-cover"><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 max-w-16 sm:max-w-20 md:max-w-24 lg:max-w-28 tracking-wider">Matheus Moraes</span></div>
                </div>
              </div>
            </div>
          </details>
        </div>

        <!-- Belvo -->
        <div class="company-row border-b border-black" data-country="Mexico" data-sector="FinTech">
          <details class="collapse-table">
            <summary class="flex items-center py-2 sm:py-3 md:py-3.5 lg:py-[18px] 2xl:py-[26px] cursor-pointer hover:bg-primary transition-all duration-300 list-none">
              <span class="font-manrope text-[9px] sm:text-sm md:text-base lg:text-xl 2xl:text-3xl leading-3 sm:leading-5 md:leading-6 lg:leading-7 2xl:leading-10 text-black collapse-text flex-1 pl-1 sm:pl-2 md:pl-4 lg:pl-6">Belvo</span>
              <div class="flex justify-between items-center pr-3 sm:pr-4 md:pr-5 lg:pr-7 2xl:pr-10 gap-6 sm:gap-4 md:gap-3 lg:gap-0" style="flex: 3;">
                <span class="font-manrope text-[6.5px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl leading-none sm:leading-4 md:leading-5 lg:leading-[22px] 2xl:leading-8 text-black collapse-text max-w-lg short-description transition-opacity duration-300">The Open Banking API platform for Latin America.</span>
                <div class="relative min-w-[24px] min-h-6 sm:min-w-[32px] sm:min-h-8 md:min-w-[40px] md:min-h-10 lg:w-[52px] lg:h-[52px] 2xl:w-[73px] 2xl:h-[73px]">
                  <svg class="collapse-icon w-full h-full text-black collapse-text" data-plus viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
                  <svg class="collapse-icon w-full h-full text-black collapse-text" data-minus viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
                </div>
              </div>
            </summary>
            <div class="collapse-content bg-primary px-3 sm:px-5 md:px-7 lg:px-11 2xl:px-16 py-4 sm:py-5 md:py-6 lg:py-8">
              <img src="https://assets.decocache.com/maya/4c03bb13-bf78-46c6-aa28-0e8e7914f5ca/belvo_point-(1).svg" alt="Belvo" class="h-8 sm:h-9 md:h-10 lg:h-12 object-contain mb-4">
              <div class="flex justify-between gap-4 2xl:gap-6 mt-2 sm:mt-3 md:mt-4 lg:mt-6 2xl:mt-9 mb-3 sm:mb-5 md:mb-7 lg:mb-10 2xl:mb-14">
                <div><span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block">Sector</span><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">FinTech</span></div>
                <div><span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block">Website</span><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">belvo.co</span></div>
                <div><span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block">Co-Investors</span><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">FJ Labs, Founders Fund, Hedosophia, Kaszek, Y Combinator</span></div>
              </div>
              <p class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8">The Open Banking API platform for Latin America, enabling companies to access and interpret their users' financial data.</p>
              <div class="mt-3 sm:mt-5 md:mt-7 lg:mt-10 2xl:mt-14">
                <span class="font-bold text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 block mb-1 sm:mb-2 md:mb-2 lg:mb-3 2xl:mb-4">Founders</span>
                <div class="flex flex-wrap gap-3 sm:gap-4 md:gap-6 lg:gap-[34px] 2xl:gap-12">
                  <div class="flex items-center gap-2 2xl:gap-3 w-2/5 lg:w-auto"><img src="images/supabase/233f6304-c948-4ef7-b861-a4241d85dbfc.jpg" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 lg:w-[71px] lg:h-[71px] 2xl:w-[100px] 2xl:h-[100px] rounded-full object-cover"><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 max-w-16 sm:max-w-20 md:max-w-24 lg:max-w-28 tracking-wider">Pablo Viguera</span></div>
                  <div class="flex items-center gap-2 2xl:gap-3 w-2/5 lg:w-auto"><img src="images/supabase/887c7e31-5f48-4c86-9dfb-30292cfd1efa.jpg" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 lg:w-[71px] lg:h-[71px] 2xl:w-[100px] 2xl:h-[100px] rounded-full object-cover"><span class="text-white text-[9px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl sm:leading-5 md:leading-5 lg:leading-[22px] 2xl:leading-8 max-w-16 sm:max-w-20 md:max-w-24 lg:max-w-28 tracking-wider">Oriol Tintore</span></div>
                </div>
