  <!-- JavaScript -->
  <script src="js/main.js"></script>
  <script>
    // Portfolio filters
    const countryFilter = document.getElementById('countryFilter');
    const sectorFilter = document.getElementById('sectorFilter');
    const companyRows = document.querySelectorAll('.company-row');

    function filterCompanies() {
      const country = countryFilter.value;
      const sector = sectorFilter.value;

      companyRows.forEach(row => {
        const rowCountry = row.dataset.country;
        const rowSectors = row.dataset.sector.split(',');

        const matchCountry = country === 'all' || rowCountry === country;
        const matchSector = sector === 'all' || rowSectors.includes(sector);

        row.style.display = (matchCountry && matchSector) ? '' : 'none';
      });
    }

    countryFilter.addEventListener('change', filterCompanies);
    sectorFilter.addEventListener('change', filterCompanies);
  </script>
</body>
