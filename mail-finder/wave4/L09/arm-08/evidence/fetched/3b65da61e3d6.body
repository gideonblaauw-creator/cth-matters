            </div>
          </details>
        </div>

        <!-- Gupy -->
        <div class="company-row border-b border-black" data-country="Brazil" data-sector="HR Tech">
          <details class="collapse-table">
            <summary class="flex items-center py-2 sm:py-3 md:py-3.5 lg:py-[18px] 2xl:py-[26px] cursor-pointer hover:bg-primary transition-all duration-300 list-none">
              <span class="font-manrope text-[9px] sm:text-sm md:text-base lg:text-xl 2xl:text-3xl leading-3 sm:leading-5 md:leading-6 lg:leading-7 2xl:leading-10 text-black collapse-text flex-1 pl-1 sm:pl-2 md:pl-4 lg:pl-6">Gupy</span>
              <div class="flex justify-between items-center pr-3 sm:pr-4 md:pr-5 lg:pr-7 2xl:pr-10 gap-6 sm:gap-4 md:gap-3 lg:gap-0" style="flex: 3;">
                <span class="font-manrope text-[6.5px] sm:text-xs md:text-xs lg:text-sm 2xl:text-xl leading-none sm:leading-4 md:leading-5 lg:leading-[22px] 2xl:leading-8 text-black collapse-text max-w-lg short-description transition-opacity duration-300">Recruitment tech platform for companies looking to hire talent in LatAm.</span>
                <div class="relative min-w-[24px] min-h-6 sm:min-w-[32px] sm:min-h-8 md:min-w-[40px] md:min-h-10 lg:w-[52px] lg:h-[52px] 2xl:w-[73px] 2xl:h-[73px]">
                  <svg class="collapse-icon w-full h-full text-black collapse-text" data-plus viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
                  <svg class="collapse-icon w-full h-full text-black collapse-text" data-minus viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
                </div>
              </div>
            </summary>
            <div class="collapse-content bg-primary px-3 sm:px-5 md:px-7 lg:px-11 2xl:px-16 py-4 sm:py-5 md:py-6 lg:py-8">
